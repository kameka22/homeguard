# header for the toolchain it needs).
/app/src-tauri/resources/agents/

# Frontend
/app/node_modules/
/app/dist/

# Local environment / secrets — none checked in today, but never start one
.env
.env.local
*.pem
*.key

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS cruft
.DS_Store
._*
Thumbs.db
